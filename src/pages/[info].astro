---
import GalleryInfoPage from '../components/GalleryInfoPage.astro';
import { galleryPages } from '../data/gallery-pages';
export function getStaticPaths() {
  return galleryPages.map(page => ({ params: { info: page.ro.split('/').filter(Boolean)[0] }, props: { page } }));
}
const { page } = Astro.props;
---
<GalleryInfoPage page={page} lang="ro" />
