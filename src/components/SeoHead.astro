---
import { artistIdentity } from '../lib/identity';
interface Props {
  title: string;
  description: string;
  lang: 'ro' | 'en';
  romanianPath: string;
  englishPath: string;
  image: string;
  imageAlt: string;
  structuredData?: Record<string, unknown>;
  breadcrumbs?: { name: string; path: string }[];
}
const { title, description, lang, romanianPath, englishPath, image, imageAlt, structuredData } = Astro.props;
if (!Astro.site) throw new Error('SEO metadata requires Astro site.');
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(lang === 'ro' ? romanianPath : englishPath);
const artist = artistIdentity(Astro.site, lang);
const website = {
  '@type': 'WebSite', '@id': absolute('/#website'),
  url: absolute('/'), name: 'MART Gallery',
  alternateName: 'MART Gallery — Marian Preoteșescu',
  inLanguage: ['ro', 'en'], creator: { '@id': artist['@id'] },
};
const breadcrumbs = Astro.props.breadcrumbs;
const graph = [website, artist,
  ...(structuredData ? [{ ...structuredData, '@context': undefined, '@id': `${canonical}#${structuredData['@type'] === 'VisualArtwork' ? 'artwork' : 'webpage'}` }] : []),
  ...(breadcrumbs ? [{
    '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`,
    itemListElement: breadcrumbs.map((item, index) => ({
      '@type': 'ListItem', position: index + 1, name: item.name, item: absolute(item.path),
    })),
  }] : []),
];
---
<title>{title}</title>
<meta name="google-site-verification" content="6bRKA6hpe_1BhrIOB2hn6ObYoo1ezjf9ZrKPwn8VPpc" />
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="ro" href={absolute(romanianPath)} />
<link rel="alternate" hreflang="en" href={absolute(englishPath)} />
<link rel="alternate" hreflang="x-default" href={absolute(romanianPath)} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="MART Gallery" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang === 'ro' ? 'ro_RO' : 'en_US'} />
<meta property="og:locale:alternate" content={lang === 'ro' ? 'en_US' : 'ro_RO'} />
<meta property="og:image" content={absolute(image)} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absolute(image)} />
<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\u003c')} />
