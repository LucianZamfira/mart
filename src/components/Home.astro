---
import ArtworkCard from './flex/ArtworkCard.astro';
import SectionLabel from './ui/SectionLabel.astro';
import SeoHead from './SeoHead.astro';
import { getArtworks, type Language } from '../lib/artworks';
import '../styles/global.css';
interface Props { lang: Language }
const { lang } = Astro.props;
const ro = lang === 'ro';
const artworks = getArtworks(lang);
const techniques = [...new Set(artworks.map(item => item.technique))];
const collections = [...new Set(artworks.map(item => item.collection))];
const t = (romanian: string, english: string) => ro ? romanian : english;
---
<!doctype html>
<html lang={lang}>
  <head><link rel="icon" type="image/png" href="/images/favicon.png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={t('MART Gallery — Picturi de Marian Preoteșescu', 'MART Gallery — Paintings by Marian Preoteșescu')}
      description={t('Descoperă picturile lui Marian Preoteșescu: portrete, păsări și flori în acrilic. Explorează lucrările din MART Gallery și contactează artistul.', 'Discover paintings by Marian Preoteșescu: acrylic portraits, birds and flowers. Explore the works at MART Gallery and contact the artist.')}
      lang={lang} romanianPath="/" englishPath="/en/"
      image="/paintings/184744.webp" imageAlt={t('Chip în fragmente de culoare — Marian Preoteșescu', 'Face in Fragments of Colour — Marian Preoteșescu')}
      structuredData={{
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: 'MART Gallery — Marian Preoteșescu',
        url: new URL(ro ? '/' : '/en/', Astro.site).href,
        inLanguage: lang,
        about: { '@type': 'Person', name: 'Marian Preoteșescu', sameAs: ['https://www.instagram.com/marianpreo'] },
        mainEntity: { '@type': 'ItemList', itemListElement: artworks.map((artwork, index) => ({
          '@type': 'ListItem', position: index + 1, name: artwork.title, url: new URL(artwork.url, Astro.site).href,
        })) },
      }}
    />
  </head>
  <body>
    <a class="skip" href="#main">{t('Sari la conținut', 'Skip to content')}</a>
    <header class="wrap">
      <a class="brand" href={ro ? '/' : '/en/'} aria-label="MART Gallery"><img class="brand-mark" src="/images/mart-monogram.svg" alt="" width="112" height="109" /></a>
      <nav aria-label={t('Navigare principală', 'Main navigation')}>
        <a href="#gallery">{t('Lucrări', 'Works')}</a><a href="#about">{t('Despre', 'About')}</a><a href="#contact">Contact</a>
      </nav>
      <div class="languages" aria-label={t('Limba', 'Language')}><a href="/" lang="ro" aria-current={ro ? 'page' : undefined}>RO</a><span>/</span><a href="/en/" lang="en" aria-current={!ro ? 'page' : undefined}>EN</a></div>
    </header>
    <main id="main">
      <section class="hero hero-color wrap">
        <div class="hero-painting hero-portrait" aria-hidden="true"><img src="/paintings/184744.webp" alt="" width="1870" height="1873" fetchpriority="high" /><video id="hero-video" muted loop playsinline preload="none" poster="/paintings/184744.webp" data-src="/paintings/animated-paint.mp4"></video></div><div class="hero-painting hero-bird" aria-hidden="true"><img src="/paintings/184741.webp" alt="" width="1870" height="1873" /></div><span class="hero-dot dot-blue" aria-hidden="true"></span><span class="hero-dot dot-gold" aria-hidden="true"></span><div class="hero-copy"><p class="eyebrow">{t('UN UNIVERS SEMNAT MARIAN', 'A WORLD BY MARIAN')}</p>
          <h1>{t('Lumea, privită', 'The world, seen')}<br /><em>{t('în culori.', 'in colour.')}</em></h1>
          <p class="hero-artist">Marian Preoteșescu</p><p class="intro">{t('Un loc pentru pictură, emoție și lucrurile care merită privite mai îndeaproape.', 'A place for painting, emotion and the things that deserve a closer look.')}</p>
          <a class="button" href="#gallery">{t('Descoperă lucrările', 'Explore the works')} <span aria-hidden="true">↗</span></a>
        </div>
        <button type="button" class="hero-video-toggle" hidden data-pause={t('Oprește animația', 'Pause animation')} data-play={t('Pornește animația', 'Play animation')}>{t('Oprește animația', 'Pause animation')}</button><div class="hero-foot"><span class="label">{t('PICTURĂ & EXPLORĂRI VIZUALE', 'PAINTING & VISUAL EXPLORATIONS')}</span><a href="#gallery" title="MART GALLERY">MART GALLERY <span aria-hidden="true">↓</span></a></div>
      </section>
      <section id="gallery" class="gallery wrap">
        <div class="section-head"><div><SectionLabel number="01" label={t('GALERIE', 'GALLERY')} /><h2>{t('Din atelier.', 'From the studio.')}</h2></div><p>{t('Fiecare pânză, o altă poveste.', 'Every canvas, another story.')}</p></div>
        <div class="filters">
          <label>{t('Tehnică', 'Technique')}<select id="technique"><option value="">{t('Toate tehnicile', 'All techniques')}</option>{techniques.map(value => <option>{value}</option>)}</select></label>
          <label>{t('Colecție', 'Collection')}<select id="collection"><option value="">{t('Toate colecțiile', 'All collections')}</option>{collections.map(value => <option>{value}</option>)}</select></label>
          <span id="count" role="status" aria-live="polite" data-unit={t('lucrări', 'works')}>{artworks.length} {t('lucrări', 'works')}</span>
        </div>
        <div class="artworks" id="artwork-grid">{artworks.map(artwork => <ArtworkCard artwork={artwork} />)}</div>
        <div class="gallery-more" hidden><button class="button" id="load-more" type="button" aria-controls="artwork-grid">{t('Încarcă mai multe', 'Load more')} <span aria-hidden="true">↓</span></button></div>
        <div class="empty" id="empty" hidden={artworks.length > 0}><span aria-hidden="true">✳</span><h3>{t('Poveștile pe pânză ajung în curând.', 'Stories on canvas are coming soon.')}</h3><p>{t('Pregătim primele lucrări pentru galerie. Până atunci, ne poți scrie mai jos.', 'We are preparing the first works for the gallery. In the meantime, get in touch below.')}</p></div>
        <p id="no-results" class="empty" hidden>{t('Nicio lucrare nu corespunde filtrelor selectate.', 'No works match the selected filters.')}</p>
      </section>
      <section id="about" class="about about-atelier" aria-labelledby="artist-heading">
        <div class="atelier-texture" aria-hidden="true"></div>
        <div class="wrap atelier-inner">
          <div class="atelier-art" aria-hidden="true">
            <div class="atelier-number"><SectionLabel number="02" label={t('ATELIER', 'STUDIO')} /></div>
            <img class="atelier-concept" src="/images/atelier-concept.webp" alt="" width="800" height="512" loading="lazy" decoding="async" />
          </div>
          <div class="atelier-copy">
            <p class="eyebrow">{t('DESPRE ARTIST', 'ABOUT THE ARTIST')}</p>
            <h2 id="artist-heading">Marian Preoteșescu</h2>
            <span class="atelier-rule" aria-hidden="true"></span>
            <p class="atelier-description">{t('MART Gallery este spațiul dedicat picturilor lui Marian Preoteșescu. Aici, lucrările se întâlnesc într-o colecție în continuă creștere, invitând la răgaz și descoperire.', 'MART Gallery is a space dedicated to Marian Preoteșescu’s paintings. Here, the works come together in a growing collection, inviting a moment of pause and discovery.')}</p>
            <div class="atelier-bottom">
              <a class="atelier-identity" href="https://www.instagram.com/marianpreo" target="_blank" rel="noopener noreferrer" aria-label={t('Profilul Instagram al lui Marian Preoteșescu (se deschide într-o filă nouă)', 'Marian Preoteșescu on Instagram (opens in a new tab)')} title={t('Vezi profilul Instagram', 'View Instagram profile')}><img src="/images/marian-preotesescu-avatar.png" alt="" width="44" height="44" loading="lazy" decoding="async" /><span>{t('Vezi profilul Instagram', 'View Instagram profile')} <span aria-hidden="true">↗</span></span></a>
              <a class="atelier-link" href="#gallery">{t('Explorează lucrările', 'Explore the works')} <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </section>
      <section id="contact" class="contact wrap"><div><SectionLabel number="03" label="CONTACT" /><h2>{t('Să vorbim', 'Let’s talk')}<br /><em>{t('despre artă.', 'about art.')}</em></h2><p>{t('Pentru detalii despre lucrări, lucrări la cerere sau un simplu salut.', 'For details about the paintings, custom works or just to say hello.')}</p><a class="email" href="mailto:marianpreo@gmail.com">marianpreo@gmail.com ↗</a></div>
        <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action={ro ? '/multumim/' : '/en/thank-you/'}>
          <input type="hidden" name="form-name" value="contact" /><input type="hidden" name="language" value={lang} />
          <p hidden><label>Leave empty <input name="bot-field" /></label></p>
          <label>{t('Numele tău', 'Your name')}<input name="name" autocomplete="name" required maxlength="120" /></label>
          <label>Email<input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
          <label>{t('Mesajul tău', 'Your message')}<textarea name="message" rows="4" required maxlength="5000"></textarea></label>
          <p class="form-note">{t('Folosim datele din formular doar pentru a răspunde mesajului tău. Mesajul este procesat prin Netlify Forms.', 'We use your details only to reply to your message. Submissions are processed through Netlify Forms.')}</p>
          <button class="button" type="submit">{t('Trimite mesajul', 'Send message')} <span aria-hidden="true">↗</span></button>
        </form>
      </section>
    </main>
    <footer class="wrap"><span>© {new Date().getFullYear()} MART Gallery</span><span>{t('Artă care rămâne cu tine.', 'Art that stays with you.')}</span><a href="#main">{t('Înapoi sus', 'Back to top')} ↑</a></footer>
    <script>
      const heroVideo = document.querySelector<HTMLVideoElement>('#hero-video');
      const videoToggle = document.querySelector<HTMLButtonElement>('.hero-video-toggle');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (heroVideo && videoToggle) {
        const updateVideo = () => {
          if (reducedMotion.matches) {
            heroVideo.pause();
            heroVideo.parentElement?.classList.remove('is-playing');
            videoToggle.hidden = true;
            return;
          }
          if (!heroVideo.getAttribute('src')) heroVideo.src = heroVideo.dataset.src || '';
          heroVideo.muted = true;
          heroVideo.play().catch(() => { videoToggle.hidden = false; videoToggle.textContent = videoToggle.dataset.play || ''; });
        };
        heroVideo.addEventListener('playing', () => {
          heroVideo.parentElement?.classList.add('is-playing');
          videoToggle.hidden = false;
          videoToggle.textContent = videoToggle.dataset.pause || '';
        });
        heroVideo.addEventListener('pause', () => { videoToggle.textContent = videoToggle.dataset.play || ''; });
        heroVideo.addEventListener('error', () => {
          heroVideo.parentElement?.classList.remove('is-playing');
          videoToggle.hidden = true;
        });
        videoToggle.addEventListener('click', () => {
          if (heroVideo.paused) heroVideo.play().catch(() => {});
          else heroVideo.pause();
        });
        reducedMotion.addEventListener('change', updateVideo);
        updateVideo();
      }
      const technique = document.querySelector<HTMLSelectElement>('#technique');
      const collection = document.querySelector<HTMLSelectElement>('#collection');
      const cards = Array.from(document.querySelectorAll<HTMLElement>('artwork-card'));
      const grid = document.querySelector<HTMLElement>('#artwork-grid');
      let masonryFrame = 0;
      function layoutGallery() {
        if (!grid) return;
        const styles = getComputedStyle(grid);
        const columns = Number(styles.getPropertyValue('--gallery-columns')) || 3;
        const gap = parseFloat(styles.columnGap) || 0;
        const width = (grid.clientWidth - gap * (columns - 1)) / columns;
        if (width <= 0) return;
        grid.classList.add('is-masonry');
        const heights = Array<number>(columns).fill(0);
        cards.filter(card => !card.hidden).forEach(card => {
          card.style.width = `${width}px`;
          const column = heights.indexOf(Math.min(...heights));
          card.style.left = `${column * (width + gap)}px`;
          card.style.top = `${heights[column]}px`;
          heights[column] += card.getBoundingClientRect().height + gap;
        });
        grid.style.height = `${Math.max(0, ...heights) - (heights.some(Boolean) ? gap : 0)}px`;
      }
      function scheduleGalleryLayout() {
        cancelAnimationFrame(masonryFrame);
        masonryFrame = requestAnimationFrame(layoutGallery);
      }
      const cardObserver = new ResizeObserver(scheduleGalleryLayout);
      cards.forEach(card => {
        cardObserver.observe(card);
        card.querySelector('img')?.addEventListener('load', scheduleGalleryLayout);
      });
      let galleryWidth = 0;
      if (grid) new ResizeObserver(([entry]) => {
        if (entry.contentRect.width !== galleryWidth) {
          galleryWidth = entry.contentRect.width;
          scheduleGalleryLayout();
        }
      }).observe(grid);
      customElements.whenDefined('artwork-card').then(scheduleGalleryLayout);
      const requestedArtwork = new URLSearchParams(window.location.search).get('artwork');
      const message = document.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
      if (requestedArtwork && message && !message.value) {
        const card = cards.find(item => item.getAttribute('href')?.split('/').filter(Boolean).pop() === requestedArtwork);
        const title = card?.querySelector('h3')?.textContent;
        if (title) message.value = document.documentElement.lang === 'ro'
          ? `Bună ziua! Aș dori mai multe detalii despre lucrarea „${title}”.`
          : `Hello! I would like more information about the artwork “${title}”.`;
      }
      const loadMore = document.querySelector<HTMLButtonElement>('#load-more');
      const moreContainer = document.querySelector<HTMLElement>('.gallery-more');
      let limit = 6;
      function renderGallery() {
        let matched = 0;
        let firstNew: HTMLElement | undefined;
        cards.forEach(card => {
          const matches = (!technique?.value || card.dataset.technique === technique.value)
            && (!collection?.value || card.dataset.collection === collection.value);
          const show = Boolean(matches && matched < limit);
          if (show && card.hidden && !firstNew) firstNew = card;
          card.hidden = !show;
          if (matches) matched++;
        });
        const count = document.querySelector('#count');
        const shown = Math.min(limit, matched);
        if (count) count.textContent = document.documentElement.lang === 'ro'
          ? `${shown} din ${matched} lucrări`
          : `${shown} of ${matched} works`;
        const empty = document.querySelector<HTMLElement>('#no-results');
        if (empty) empty.hidden = matched > 0 || cards.length === 0;
        if (moreContainer) moreContainer.hidden = shown >= matched;
        scheduleGalleryLayout();
        return firstNew;
      }
      function filter() { limit = 6; renderGallery(); }
      loadMore?.addEventListener('click', () => {
        limit += 6;
        const firstNew = renderGallery();
        firstNew?.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
      });
      technique?.addEventListener('change', filter);
      collection?.addEventListener('change', filter);
      renderGallery();
    </script>
  </body>
</html>
