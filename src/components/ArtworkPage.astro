---
import { artworkUrl, getArtworks, type Artwork, type Language } from '../lib/artworks';
import '../styles/global.css';
interface Props { artwork: Artwork; lang: Language }
const { artwork, lang } = Astro.props;
const ro = lang === 'ro';
const t = (a: string, b: string) => ro ? a : b;
const home = ro ? '/' : '/en/';
const works = getArtworks(lang);
const index = works.findIndex(item => item.slug === artwork.slug);
const previous = works[index - 1];
const next = works[index + 1];
---
<!doctype html>
<html lang={lang}>
  <head><link rel="icon" type="image/png" href="/images/favicon.png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{artwork.title} — MART Gallery</title>
    <meta name="description" content={artwork.description || `${artwork.title} · Marian Preoteșescu · ${artwork.technique}`} />
    <link rel="alternate" hreflang="ro" href={artworkUrl(artwork.slug, 'ro')} />
    <link rel="alternate" hreflang="en" href={artworkUrl(artwork.slug, 'en')} />
  </head>
  <body>
    <a class="skip" href="#main">{t('Sari la conținut', 'Skip to content')}</a>
    <header class="wrap">
      <a class="brand" href={home} aria-label="MART Gallery"><img class="brand-mark" src="/images/mart-monogram.svg" alt="" width="112" height="109" /></a>
      <nav aria-label={t('Navigare principală', 'Main navigation')}>
        <a href={`${home}#gallery`}>{t('Lucrări', 'Works')}</a><a href={`${home}#about`}>{t('Despre', 'About')}</a><a href={`${home}#contact`}>Contact</a>
      </nav>
      <div class="languages"><a href={artworkUrl(artwork.slug, 'ro')} lang="ro" aria-current={ro ? 'page' : undefined}>RO</a><span>/</span><a href={artworkUrl(artwork.slug, 'en')} lang="en" aria-current={!ro ? 'page' : undefined}>EN</a></div>
    </header>
    <main id="main" class="wrap detail">
      <div class="detail-top"><nav aria-label={t('Locația în site', 'Breadcrumb')}><a href={`${home}#gallery`}>{t('Galerie', 'Gallery')}</a><span aria-hidden="true">/</span><span>{artwork.collection}</span></nav><a href={`${home}#gallery`}>← {t('Înapoi la galerie', 'Back to gallery')}</a></div>
      <div class="detail-grid">
        <figure class="detail-figure">
          <a href={artwork.image} class="detail-zoom" data-zoom aria-label={t('Mărește imaginea', 'Enlarge image')}><img src={artwork.image} alt={artwork.title} width="1870" height="1873" fetchpriority="high" /></a>
          <figcaption><a href={artwork.image} data-zoom>⊕ {t('Vezi detaliile lucrării', 'View artwork details')}</a></figcaption>
        </figure>
        <section class="detail-info" aria-labelledby="artwork-title">
          <p class="eyebrow">{t('COLECȚIA', 'COLLECTION')} / {artwork.collection}</p>
          <h1 id="artwork-title">{artwork.title}</h1>
          <p class="detail-artist">Marian Preoteșescu</p>
          {artwork.description && <p class="detail-description">{artwork.description}</p>}
          <dl><div><dt>{t('Tehnică', 'Technique')}</dt><dd>{artwork.technique}</dd></div><div><dt>{t('Colecție', 'Collection')}</dt><dd>{artwork.collection}</dd></div></dl>
          <a class="button" href={`${home}?artwork=${encodeURIComponent(artwork.slug)}#contact`}>{t('Întreabă despre această lucrare', 'Ask about this artwork')} <span aria-hidden="true">↗</span></a>
          <p class="detail-note">{t('Scrie-ne pentru detalii despre lucrare.', 'Get in touch for details about the artwork.')}</p>
        </section>
      </div>
      <nav class="detail-pagination" aria-label={t('Navigare între lucrări', 'Artwork navigation')}>
        {previous ? <a href={previous.url}><span>← {t('Lucrarea anterioară', 'Previous artwork')}</span><strong>{previous.title}</strong></a> : <span />}
        {next && <a href={next.url}><span>{t('Următoarea lucrare', 'Next artwork')} →</span><strong>{next.title}</strong></a>}
      </nav>
    </main>
    <footer class="wrap"><span>© {new Date().getFullYear()} MART Gallery</span><a href={`${home}#gallery`}>{t('Toate lucrările', 'All works')} ↗</a></footer>
    <dialog class="artwork-dialog" aria-label={t('Imagine mărită', 'Enlarged image')}>
      <form method="dialog"><button type="submit" autofocus>{t('Închide', 'Close')} ×</button></form>
      <img src={artwork.image} alt={artwork.title} width="1870" height="1873" loading="lazy" />
    </dialog>
    <script>
      const dialog = document.querySelector<HTMLDialogElement>('.artwork-dialog');
      document.querySelectorAll<HTMLAnchorElement>('[data-zoom]').forEach(link => {
        link.addEventListener('click', event => {
          if (!dialog || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          dialog.showModal();
        });
      });
      dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    </script>
  </body>
</html>
<style>
  .detail { padding-top: 28px; }
  .detail-top { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 36px; font-size: 12px; }
  .detail-top nav { gap: 16px; font-size: inherit; }
  .detail-top>a { color: var(--accent); }
  .detail-grid { display: grid; grid-template-columns: 1.2fr 1fr; align-items: center; gap: 7%; }
  .detail-figure { margin: 0; min-width: 0; }
  .detail-zoom { display: block; cursor: zoom-in; }
  .detail-figure img { display: block; width: 100%; height: auto; }
  figcaption { padding-block: 18px; font-size: 11px; letter-spacing: 2px; }
  .detail-info { min-width: 0; padding-block: 20px; }
  .detail-info .eyebrow { color: var(--accent); line-height: 1.7; }
  .detail-info h1 { font-size: clamp(36px, 4.3vw, 64px); letter-spacing: -2px; overflow-wrap: anywhere; }
  .detail-artist { font: 25px Georgia, serif; margin: 20px 0 30px; }
  .detail-description { font: 19px/1.7 Georgia, serif; }
  dl { margin: 30px 0; }
  dl div { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; border-top: 1px solid #d8d5ca; padding: 15px 0; font-size: 14px; }
  dl div:last-child { border-bottom: 1px solid #d8d5ca; }
  dd { margin: 0; }
  .detail-info .button { background: var(--accent); line-height: 1.5; }
  .detail-info .button:hover { background: var(--ink); }
  .detail-note { font-size: 12px; color: var(--muted); line-height: 1.6; }
  .detail-pagination { display: flex; justify-content: space-between; border-top: 1px solid #d8d5ca; padding: 30px 0 45px; margin-top: 40px; gap: 30px; }
  .detail-pagination a { max-width: 45%; font-size: 12px; color: var(--accent); line-height: 1.6; }
  .detail-pagination a:last-child { text-align: right; }
  .detail-pagination strong { display: block; font: 18px/1.5 Georgia, serif; color: var(--ink); margin-top: 8px; }
  .artwork-dialog { border: 0; padding: 16px; width: min(95vw, 1100px); max-height: 94dvh; background: var(--bg); }
  .artwork-dialog::backdrop { background: #14231ce6; }
  .artwork-dialog form { text-align: right; margin-bottom: 10px; }
  .artwork-dialog button { background: var(--ink); color: var(--bg); padding: 10px 18px; border: 0; cursor: pointer; }
  .artwork-dialog img { display: block; width: 100%; height: auto; max-height: 78dvh; object-fit: contain; }
  @media(max-width: 700px) {
    .detail-top { flex-wrap: wrap; font-size: 11px; margin-bottom: 25px; }
    .detail-grid { grid-template-columns: 1fr; gap: 10px; }
    .detail-info h1 { font-size: 42px; }
    .detail-artist { font-size: 23px; }
    .detail-pagination strong { font-size: 16px; }
  }
</style>
