---
interface Props {
  number: string;
  label: string;
}

const { number, label } = Astro.props;
---

<span class="section-label">{number} / {label}</span>

<style>
  .section-label {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 24px;
    color: var(--accent);
    font: 400 10px/1.5 Arial, Helvetica, sans-serif;
    letter-spacing: 3px;
  }

  .section-label::after {
    content: '';
    flex: 0 0 45px;
    border-top: 1px solid currentColor;
  }
</style>
