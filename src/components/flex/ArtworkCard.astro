---
import type { Artwork } from '../../lib/artworks';
interface Props { artwork: Artwork }
const { artwork } = Astro.props;
---
<artwork-card href={artwork.url} data-technique={artwork.technique} data-collection={artwork.collection}>
  <a href={artwork.url}>
    <div class="image"><img src={artwork.preview.src} srcset={artwork.preview.srcset} sizes="(max-width: 440px) 88vw, (max-width: 700px) 42vw, (max-width: 1400px) 28vw, 390px" alt={artwork.title} width={artwork.preview.width} height={artwork.preview.height} loading="lazy" decoding="async" /></div>
    <h3>{artwork.title}</h3>
    <p>{artwork.technique} · {artwork.collection}</p>
  </a>
</artwork-card>
<script>import '../ui/ArtworkCard/index.js';</script>
<style>
  a { display: block; color: inherit; text-decoration: none; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  a:hover h3 { text-decoration: underline; text-underline-offset: 4px; }
  .image { overflow: hidden; }
  img { width: 100%; height: auto; display: block; transition: transform .3s; }
  h3 { font: 1.6rem Georgia, serif; margin: 1rem 0 .4rem; }
  p { color: var(--muted); font-size: .85rem; margin: 0; }
  @media (prefers-reduced-motion: no-preference) { a:hover img { transform: scale(1.025); } }
</style>
